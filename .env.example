# Скопируйте в .env: cp .env.example .env
# Соответствует полям app/config.py (pydantic-settings).

# PostgreSQL (локально: make docker-up, база hotel_db)
DATABASE_URL=postgresql+asyncpg://hotel_user:hotel_pass@localhost:5432/hotel_db
# Интеграционные тесты: make test-db-setup (создаёт hotel_test + migrate)
# или раскомментируйте строку ниже и выставьте DATABASE_URL вручную
# DATABASE_URL=postgresql+asyncpg://hotel_user:hotel_pass@localhost:5432/hotel_test

# JWT-сессии (обязательно; в продакшене замените на случайный ключ)
SECRET_KEY=change-this-to-a-random-secret-key-in-production

DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ЮKassa необязательно для локального демо без реальных платежей (можно оставить пустым)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
